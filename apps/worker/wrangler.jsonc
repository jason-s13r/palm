// palm's own staging instance, deployed from `main` by Workers Builds.
// A real deployment uses its own repo and wrangler.template.jsonc instead.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "palm-staging",
  "main": "staging/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Staging lives on its own throwaway hosts under 1j.nz. They're flat
  // (palm-test-lemmy, not lemmy.palm-test) so Cloudflare's free certificate
  // covers them. Anything staging mints is disposable; 1j.nz itself is not.
  "vars": {
    "STAGING_DOMAIN": "palm-test.1j.nz",
    "STAGING_LEMMY_HOST": "palm-test-lemmy.1j.nz",
    "STAGING_MASTODON_HOST": "palm-test-mastodon.1j.nz"
  },
  "routes": [
    { "pattern": "palm-test.1j.nz", "custom_domain": true },
    { "pattern": "palm-test-lemmy.1j.nz", "custom_domain": true },
    { "pattern": "palm-test-mastodon.1j.nz", "custom_domain": true }
  ]
}
