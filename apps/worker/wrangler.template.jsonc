// Starting point for a deployment repo's wrangler.jsonc. Copy it, then replace
// every <...> value. The entry point is the deployment's own src/index.ts,
// which passes its palm.config.ts to createPalm().
{
  "name": "<worker-name>",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // One route per host in palm.config.ts: the domain itself and each API host.
  "routes": [
    { "pattern": "<domain>/*", "zone_name": "<domain>" },
    { "pattern": "lemmy.<domain>/*", "zone_name": "<domain>" },
    { "pattern": "mastodon.<domain>/*", "zone_name": "<domain>" }
  ]
}
