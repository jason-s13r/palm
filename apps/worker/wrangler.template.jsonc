// Starting point for a deployment repo's wrangler.jsonc. Copy it, then replace
// every <...> value. The entry point is the deployment's own src/index.ts,
// which passes its palm.config.ts to createPalm().
{
  "name": "<worker-name>",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true, "issues": { "enabled": true } },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // One D1 database, by name: the first wrangler deploy creates it (as it
  // does the bucket and queue below), so no ID is needed. palm creates and
  // migrates its own tables on the first request.
  "d1_databases": [{ "binding": "DB", "database_name": "<database-name>" }],
  // An R2 bucket for uploaded images and video (optional; without it uploads
  // are refused). wrangler deploy creates it if it doesn't exist.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "<bucket-name>" }],
  // PeerTube video, optional extras palm notices when bound (see the README):
  // a frame of each upload as its thumbnail (Media Transformations, 5,000 a
  // month free), and Cloudflare Stream's renditions (paid). For renditions
  // made on a machine of your own, set the PEERTUBE_RUNNER_TOKEN secret.
  // "media": { "binding": "MEDIA_TRANSFORMS" },
  // "stream": { "binding": "STREAM" },
  // Every 10 minutes: scheduled posts go out, and in the 03:00 UTC run old
  // remote posts nobody here touched are pruned, so D1 stays small.
  "triggers": { "crons": ["*/10 * * * *"] },
  // A queue for outgoing deliveries (optional, but it keeps sending to many
  // followers out of the request). The Worker consumes its own queue;
  // wrangler deploy creates it.
  // Mastodon's streaming: one Durable Object per domain holds the open
  // connections. The entry point exports PalmStreaming for it.
  "durable_objects": { "bindings": [{ "name": "STREAMING", "class_name": "PalmStreaming" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PalmStreaming"] }],
  "queues": {
    "producers": [{ "binding": "QUEUE", "queue": "<queue-name>" }],
    // One message per run: each queue job then has the free plan's CPU time to itself.
    "consumers": [{ "queue": "<queue-name>", "max_batch_size": 1, "max_retries": 5 }]
  },
  // The domain, whole: palm serves its own paths and sends browsers on.
  "routes": [
    { "pattern": "<domain>/*", "zone_name": "<domain>" }
  ]
}
